# Google Gemini (cloud upgrade over local Ollama)
# Without this: system uses Ollama (local) → rule-based fallback
GEMINI_API_KEY=

OLLAMA_MODEL=gemma4:latest

# Bhashini (primary — govt-backed Indic TTS, 11 languages)
# Register at: https://bhashini.gov.in/ulca/model/explore-models
# Format: userID|ulcaApiKey  (pipe-separated)
BHASHINI_API_KEY=

# Sarvam AI
SARVAM_API_KEY=

# -----------------------------------------------------------------------------
# Image Generation — Video Thumbnails (Engine 1, VIDEO_THUMBNAIL format)
# -----------------------------------------------------------------------------

# Stability AI (Stable Diffusion crop imagery)
# Get key at: https://platform.stability.ai/account/keys
# Without this: SVG placeholder thumbnails are generated locally
STABILITY_API_KEY=


# -----------------------------------------------------------------------------
# External Signal APIs — Geo-Temporal Context (Campaign Orchestrator)
# Without these: system reads from nightly cache (data/signal_cache.json)
# Run CampaignOrchestrator().precache_signals() nightly to keep cache fresh
# -----------------------------------------------------------------------------

# IMD (India Meteorological Department) — weather risk scores
# API access: https://mausam.imd.gov.in/imd_latest/contents/dataacesspolicies.php
IMD_API_KEY=

# ICAR-NCIPM — pest pressure surveillance alerts
# Access: https://www.ncipm.org.in  (institutional/partner access)
NCIPM_API_KEY=

# Agmarknet — mandi price data (optional, not used in core pipeline)
# Access: https://agmarknet.gov.in
AGMARKNET_KEY=


# -----------------------------------------------------------------------------
# Delivery Platforms — Omnichannel Dispatch
# Used when integrating with real delivery infrastructure
# -----------------------------------------------------------------------------

# Gupshup — WhatsApp Business API
# https://www.gupshup.io
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=

# Exotel — IVR outbound calls
# https://exotel.com
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=

# Karix — SMS delivery
# https://www.karix.com
KARIX_API_KEY=


# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Environment: development | staging | production
ENV=development

# Data and model directories (relative to agri_marketing/)
DATA_DIR=data
MODELS_DIR=models
RESULTS_DIR=results

# Campaign attribution window in days (default: 14)
ATTRIBUTION_WINDOW_DAYS=14

# Minimum receptivity score to include a grower in a campaign batch (default: 0.03)
MIN_RECEPTIVITY_SCORE=0.03

# Minimum tehsil stock rate before messaging is blocked (default: 0.2)
MIN_STOCK_RATE=0.2

# Hours within which emergency content is generated after ICAR-NCIPM alert (default: 2)
EMERGENCY_CONTENT_WINDOW_HRS=2

# LinUCB exploration parameter — higher = more exploration (default: 0.5)
LINUCB_ALPHA=0.5

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000
